# ─────────────────────────────────────────────────────────────────────────────
# Fermah Proof Network — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (provisioned automatically by Replit or fill manually) ──────────
DATABASE_URL=postgresql://user:password@localhost:5432/fermah_db
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=fermah_db

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=change_me_to_a_random_32_char_string

# ── Blockchain — Base Sepolia ─────────────────────────────────────────────────
# Your deployer private key (WITHOUT 0x prefix)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Base Sepolia RPC (defaults to public endpoint if not set)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployed FermahProofLog contract address (set after deployment)
FERMAH_CONTRACT_ADDRESS=0x...

# Basescan API key for contract verification
# Get at: https://basescan.org/apis
BASESCAN_API_KEY=your_basescan_api_key

# ── Fermah Proving Network ────────────────────────────────────────────────────
# API key from https://fermah.xyz
FERMAH_API_KEY=your_fermah_api_key
FERMAH_API_URL=https://api.fermah.xyz

# ── Frontend (Vite / Next.js) ─────────────────────────────────────────────────
# Base Sepolia chain ID (84532)
VITE_CHAIN_ID=84532
VITE_CONTRACT_ADDRESS=0x...
VITE_BASESCAN_URL=https://sepolia.basescan.org
